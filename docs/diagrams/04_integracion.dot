
digraph G { rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=13, dpi=170, pad=0.3, nodesep=0.45, ranksep=0.6];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#2F5597", penwidth=1.3];
  edge  [fontname="DejaVu Sans", fontsize=9.5, color="#444444"];

  subgraph cluster_sync { label="a) SÍNCRONA - OpenFeign (HTTP, respuesta inmediata)"; style="rounded,filled"; fillcolor="#F3F8FF"; color="#2F5597";
     s0 [label="POST /operaciones\n(cajero)", fillcolor="#FFF2CC", color="#BF9000"];
     s1 [label="ms-operaciones-cambio", fillcolor="#FFE699", color="#BF9000"];
     s2 [label="ms-clientes\nGET /clientes/{id}\n(¿activo? ¿límite?)"];
     s3 [label="ms-divisas\nGET /tipos-cambio/vigente\n(USD-PEN)"];
     s0 -> s1; s1 -> s2 [label="Feign + CircuitBreaker\n(Resilience4j)"]; s1 -> s3 [label="Feign + timeout\n+ retry"];
  }
  subgraph cluster_async { label="b) ASÍNCRONA - RabbitMQ (eventos, sin bloquear)"; style="rounded,filled"; fillcolor="#F6EFFB"; color="#7030A0";
     a1 [label="ms-operaciones-cambio\n1. guarda operación\n2. guarda evento (Outbox)\n3. publica", fillcolor="#FFE699", color="#BF9000"];
     ex [label="Exchange topic\nfinanzas.eventos", shape=cds, fillcolor="#D9E2F3", color="#2F5597"];
     q1 [label="cola\nnotificaciones.q", shape=box3d, fillcolor="#EDE1F7", color="#7030A0"];
     q2 [label="cola\nauditoria.q", shape=box3d, fillcolor="#EDE1F7", color="#7030A0"];
     q3 [label="cola\nreportes.q", shape=box3d, fillcolor="#EDE1F7", color="#7030A0"];
     dlq [label="Dead Letter Queue\n(mensajes fallidos)", shape=box3d, fillcolor="#F8CBAD", color="#C55A11"];
     c1 [label="ms-notificaciones"]; c2 [label="ms-auditoria"]; c3 [label="ms-reportes"];
     a1 -> ex [label="operacion.registrada"]; ex -> q1; ex -> q2; ex -> q3;
     q1 -> c1; q2 -> c2; q3 -> c3; q1 -> dlq [style=dashed, label="reintentos\nagotados"];
  }
}
