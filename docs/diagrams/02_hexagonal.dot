
digraph G { rankdir=TB; compound=true; newrank=true;
  graph [fontname="DejaVu Sans", fontsize=13, dpi=170, pad=0.3, nodesep=0.45, ranksep=0.6];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#2F5597", penwidth=1.3];
  edge  [fontname="DejaVu Sans", fontsize=9.5, color="#444444"];

  subgraph cluster_in { label="ADAPTADORES DE ENTRADA (driving)"; style="rounded,filled"; fillcolor="#FFF2CC"; color="#BF9000";
     a_rest [label="REST Controller\n(Spring Web)", fillcolor="#FFFFFF", color="#BF9000"];
     a_msg  [label="RabbitMQ Listener\n(@RabbitListener)", fillcolor="#FFFFFF", color="#BF9000"];
  }
  subgraph cluster_hex { label="HEXÁGONO (núcleo sin dependencias de frameworks)"; style="rounded,filled"; fillcolor="#F3F8FF"; color="#2F5597"; penwidth=2;
     p_in  [label="PUERTOS DE ENTRADA\n«interface»\nRegistrarOperacionUseCase\nConsultarOperacionUseCase\nAnularOperacionUseCase", fillcolor="#DDEBF7"];
     uc    [label="CASOS DE USO (application)\nRegistrarOperacionService\n- orquesta el flujo", fillcolor="#E2F0D9", color="#548235"];
     dom   [label="DOMINIO\nOperacionCambio (agregado)\nMoneda, Dinero, TipoCambio (VO)\nPolítica de comisión\nReglas: límites, redondeo,\nestados", fillcolor="#FFE699", color="#BF9000"];
     p_out [label="PUERTOS DE SALIDA\n«interface»\nOperacionRepositoryPort\nTipoCambioPort\nClientePort\nEventPublisherPort", fillcolor="#DDEBF7"];
  }
  subgraph cluster_out { label="ADAPTADORES DE SALIDA (driven)"; style="rounded,filled"; fillcolor="#FBE5D6"; color="#C55A11";
     o_jpa  [label="JPA Adapter\n(Spring Data JPA)", fillcolor="#FFFFFF", color="#C55A11"];
     o_feign[label="Feign Adapter\n(clientes / divisas)", fillcolor="#FFFFFF", color="#C55A11"];
     o_rmq  [label="RabbitMQ Publisher\nAdapter", fillcolor="#FFFFFF", color="#C55A11"];
     o_ext  [label="Adapter sistemas externos\n(SBS / API tipo de cambio)", fillcolor="#FFFFFF", color="#C55A11"];
  }
  db   [label="PostgreSQL", shape=cylinder, fillcolor="#D9D9D9", color="#595959"];
  ms   [label="Otros\nmicroservicios", fillcolor="#EDE1F7", color="#7030A0"];
  mq   [label="Broker\nRabbitMQ", shape=cds, fillcolor="#EDE1F7", color="#7030A0"];
  ext  [label="Sistemas\nexternos", fillcolor="#EDE1F7", color="#7030A0"];

  a_rest -> p_in; a_msg -> p_in;
  p_in -> uc [label="implementa"]; uc -> dom [label="usa"]; uc -> p_out [label="depende de\n(inversión)"];
  p_out -> o_jpa [label="implementa", style=dashed]; p_out -> o_feign [style=dashed]; p_out -> o_rmq [style=dashed]; p_out -> o_ext [style=dashed];
  o_jpa -> db; o_feign -> ms; o_rmq -> mq; o_ext -> ext;
}
