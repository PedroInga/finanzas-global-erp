
digraph G { rankdir=TB;
  graph [fontname="DejaVu Sans", fontsize=13, dpi=170, pad=0.3, nodesep=0.45, ranksep=0.6];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#2F5597", penwidth=1.3];
  edge  [fontname="DejaVu Sans", fontsize=9.5, color="#444444"];

  subgraph cluster_l { label="EN CAPAS: la dependencia baja hasta la BD"; style="rounded,filled"; fillcolor="#FFF8F0"; color="#C55A11";
     l1 [label="Controller"]; l2 [label="Service"]; l3 [label="Repository JPA"]; l4 [label="Base de datos", shape=cylinder, fillcolor="#D9D9D9"];
     l1 -> l2 -> l3 -> l4;
  }
  subgraph cluster_h { label="HEXAGONAL: las dependencias apuntan al dominio"; style="rounded,filled"; fillcolor="#F3FFF3"; color="#548235";
     h1 [label="Adapter REST"]; h2 [label="Caso de uso + Dominio\n(núcleo)", fillcolor="#FFE699", color="#BF9000", penwidth=2];
     h3 [label="Adapter JPA"]; h4 [label="Base de datos", shape=cylinder, fillcolor="#D9D9D9"];
     h1 -> h2 [label="usa puerto IN"]; h3 -> h2 [label="implementa puerto OUT", dir=back]; h3 -> h4;
  }
}
