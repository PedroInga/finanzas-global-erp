
digraph G { rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=13, dpi=170, pad=0.3, nodesep=0.45, ranksep=0.6];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF1FB", color="#2F5597", penwidth=1.3];
  edge  [fontname="DejaVu Sans", fontsize=9.5, color="#444444"];

  u   [label="Usuario\n(cajero, analista,\nsupervisor...)", fillcolor="#FFF2CC", color="#BF9000"];
  gw  [label="API Gateway\n1. valida firma/expiración JWT\n2. rate limit\n3. propaga identidad", fillcolor="#F8CBAD", color="#C55A11", penwidth=2];
  auth[label="Servicio de Seguridad\nSpring Security\nBCrypt, emisión JWT\n+ refresh token", fillcolor="#FCE4D6", color="#C55A11"];
  ms  [label="Microservicio\nResource Server\n- @PreAuthorize (rol/permiso)\n- reglas de negocio\n  (límite por monto)", fillcolor="#E2F0D9", color="#548235"];
  aud [label="ms-auditoria\nregistro inmutable", fillcolor="#EDE1F7", color="#7030A0"];
  vault [label="Config Server + Vault\nsecretos / credenciales", fillcolor="#D9D9D9", color="#595959"];
  db  [label="BD cifrada\n(TLS + credenciales\nen variables de entorno)", shape=cylinder, fillcolor="#D9D9D9", color="#595959"];

  u -> auth [label="POST /auth/login"]; auth -> u [label="access JWT (15 min)", style=dashed];
  u -> gw [label="Authorization: Bearer"];
  gw -> ms [label="mTLS / TLS + JWT\n(X-User, X-Office)"];
  ms -> aud [label="evento de auditoría\n(quién, qué, cuándo,\noficina, importes)", style=dashed];
  vault -> ms [style=dashed, label="secretos"]; ms -> db;
}
